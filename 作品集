<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <!-- 1. 放在最前面的编码声明，解决 Mac/Win 所有浏览器的乱码问题 -->
    <meta charset="UTF-8">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>詹慧倩 | HUIQIAN ZHAN - Portfolio 2026</title>
    
    <!-- 引入外部样式库 -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;700;900&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #050505; color: white; }
        .font-serif-sc { font-family: 'Noto Serif SC', serif; }
        .blur-orb { position: fixed; border-radius: 50%; filter: blur(140px); z-index: 0; pointer-events: none; opacity: 0.18; mix-blend-mode: screen; }
        .animate-pulse-slow { animation: pulse 10s ease-in-out infinite; }
        @keyframes pulse { 0%, 100% { opacity: 0.12; transform: scale(1); } 50% { opacity: 0.22; transform: scale(1.15); } }
        .glass-card { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .gradient-text { background: linear-gradient(135deg, #ffffff 0%, #a5b4fc 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .vertical-rl { writing-mode: vertical-rl; }
    </style>
</head>
<body class="overflow-x-hidden">

    <!-- 弥散光影背景 -->
    <div class="blur-orb animate-pulse-slow bg-blue-600 w-[70vw] h-[70vw] -top-[20%] -left-[10%]"></div>
    <div class="blur-orb bg-purple-600 w-[60vw] h-[60vw] -bottom-[10%] -right-[10%]" style="animation-delay: -2s;"></div>
    <div class="blur-orb bg-pink-500 w-[40vw] h-[40vw] top-[20%] right-[10%]" style="animation-delay: -5s;"></div>

    <!-- 导航栏 -->
    <nav class="fixed top-0 left-0 w-full p-8 md:px-16 flex justify-between items-center z-50">
        <div class="text-[10px] tracking-[0.5em] uppercase font-bold text-white/30">HUIQIAN ZHAN / SHOWREEL</div>
        <div class="text-[10px] tracking-[0.5em] uppercase font-bold text-white/30 hidden md:block">2026 POST-PRODUCTION PORTFOLIO</div>
    </nav>

    <!-- 第一屏：封面 -->
    <section class="relative min-h-screen flex flex-col justify-center px-6 md:px-16 lg:px-24 z-10">
        <div class="max-w-7xl w-full mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            
            <div class="lg:col-span-8 space-y-8">
                <div class="flex items-center gap-4">
                    <span class="w-12 h-[1px] bg-blue-500/50"></span>
                    <span class="text-blue-400 text-xs tracking-[0.5em] font-bold uppercase italic font-serif-sc">Video Specialist</span>
                </div>
                
                <h1 class="text-[15vw] md:text-[11vw] font-serif-sc font-black leading-[0.85] tracking-tighter opacity-95 gradient-text">
                    PORTFOLIO<span class="text-blue-600">.</span>
                </h1>
                
                <div class="flex flex-col md:flex-row md:items-end gap-6 mt-6">
                    <div class="text-4xl md:text-6xl font-bold tracking-tight">
                        詹慧倩 <span class="text-xl md:text-2xl font-light text-white/30 block md:inline font-serif-sc italic ml-0 md:ml-4 tracking-[0.1em]">HUIQIAN ZHAN</span>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-4 lg:pt-32 space-y-12">
                <div class="space-y-6 border-l border-white/10 pl-8">
                    <p class="text-gray-300 text-lg leading-relaxed font-light">
                        具备视频全流程策划与剪辑执行能力。从网剧、微综的宏观叙事到新媒体短视频的视觉冲击，致力于用剪辑赋予素材第二次生命。
                    </p>
                </div>
                
                <!-- 个人核心数据（来自 PDF） -->
                <div class="grid grid-cols-3 gap-8 pl-8 border-t border-white/5 pt-8">
                    <div>
                        <div class="text-2xl font-serif-sc italic text-white leading-none mb-2">4Y+</div>
                        <div class="text-[8px] text-gray-500 uppercase tracking-widest leading-tight">工作经验</div>
                    </div>
                    <div>
                        <div class="text-2xl font-serif-sc italic text-white leading-none mb-2">10+</div>
                        <div class="text-[8px] text-gray-500 uppercase tracking-widest leading-tight">百万爆款</div>
                    </div>
                    <div>
                        <div class="text-2xl font-serif-sc italic text-white leading-none mb-2">200+</div>
                        <div class="text-[8px] text-gray-500 uppercase tracking-widest leading-tight">作品产出</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 第二屏：作品集网格 -->
    <section class="relative z-10 py-32 bg-white/[0.01] border-y border-white/5 backdrop-blur-3xl">
        <div class="max-w-7xl mx-auto px-6 md:px-16">
            <header class="flex flex-col md:flex-row justify-between items-end mb-24 gap-8">
                <div class="space-y-4">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-full border border-blue-500/50 flex items-center justify-center text-[10px] text-blue-500 font-bold">01</span>
                        <span class="text-blue-400 text-xs font-bold tracking-[0.4em] uppercase italic">Works Selection</span>
                    </div>
                    <h3 class="text-5xl font-serif-sc font-bold tracking-tight">精选作品集<span class="text-blue-500">.</span></h3>
                </div>
                
                <div class="flex p-1.5 bg-black/60 rounded-full border border-white/10 backdrop-blur-xl">
                    <button onclick="filterWorks('全部')" class="filter-btn active px-8 py-2.5 text-[9px] font-bold tracking-widest uppercase transition-all rounded-full bg-blue-600 text-white shadow-lg shadow-blue-600/20">全部</button>
                    <button onclick="filterWorks('影视综')" class="filter-btn px-8 py-2.5 text-[9px] font-bold tracking-widest uppercase transition-all rounded-full text-gray-500 hover:text-white">影视综</button>
                    <button onclick="filterWorks('品牌/商业')" class="filter-btn px-8 py-2.5 text-[9px] font-bold tracking-widest uppercase transition-all rounded-full text-gray-500 hover:text-white">商业</button>
                    <button onclick="filterWorks('新媒体')" class="filter-btn px-8 py-2.5 text-[9px] font-bold tracking-widest uppercase transition-all rounded-full text-gray-500 hover:text-white">新媒体</button>
                </div>
            </header>

            <div id="works-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-24">
                <!-- 脚本自动填充 -->
            </div>
        </div>
    </section>

    <!-- 第三屏：联系与合作 -->
    <footer class="relative z-10 py-32 px-6 md:px-16">
        <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-20 items-center">
            <div class="space-y-8">
                <h2 class="text-5xl font-serif-sc italic leading-tight font-bold">Ready to <span class="text-blue-500">Collaborate?</span></h2>
                <div class="space-y-2 text-gray-400 text-sm font-light">
                    <p>期望岗位：视频后期 / 资深剪辑 / 调色师</p>
                    <p>工作城市：杭州 (或远程支持全国项目)</p>
                </div>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 glass-card p-12 rounded-[2rem]">
                <div>
                    <div class="text-[10px] text-blue-500 uppercase font-black tracking-[0.2em] mb-3">电子邮箱</div>
                    <div class="text-lg font-bold select-all">2496265633@qq.com</div>
                </div>
                <div>
                    <div class="text-[10px] text-blue-500 uppercase font-black tracking-[0.2em] mb-3">联系电话</div>
                    <div class="text-lg font-bold select-all">18850464933</div>
                </div>
                <div class="sm:col-span-2 pt-6 border-t border-white/5 flex items-center gap-3">
                    <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                    <span class="text-xs text-gray-400 font-light italic tracking-wider">目前为自由接单/开放面试状态</span>
                </div>
            </div>
        </div>
        
        <div class="max-w-7xl mx-auto mt-40 flex justify-between items-center text-[9px] text-white/10 uppercase tracking-[0.5em] font-bold">
           <span>© 2026 HUIQIAN ZHAN</span>
           <span>Visual Arts & Post-Production</span>
        </div>
    </footer>

    <script>
        // 作品数据
        const works = [
            { id: 1, title: "热门网剧系列精剪", category: "影视综", desc: "登猫眼网剧榜首位。独立负责粗精剪、合成与包装。", link: "#" },
            { id: 2, title: "大型综艺后期效果", category: "影视综", desc: "主导效果包装与导演组对接，高效产出交付。", link: "#" },
            { id: 3, title: "商业宣传/调色", category: "品牌/商业", desc: "高规格商业色感把控，MG动画与实拍结合。", link: "#" },
            { id: 4, title: "新媒体百万级爆款", category: "新媒体", desc: "深度网感创作，精准卡点与热点音乐匹配。", link: "#" },
            { id: 5, title: "科普类动效设计", category: "品牌/商业", desc: "复杂信息视觉化，分镜脚本到动效全流程。", link: "#" },
            { id: 6, title: "个人 Showreel 2025", category: "其他", desc: "个人年度作品集锦，展示光影与节奏掌控力。", link: "#" }
        ];

        function renderWorks(filter = '全部') {
            const grid = document.getElementById('works-grid');
            grid.innerHTML = '';
            const filtered = filter === '全部' ? works : works.filter(w => w.category === filter);
            
            filtered.forEach(work => {
                const item = document.createElement('div');
                item.className = 'group cursor-pointer';
                item.innerHTML = `
                    <div class="relative aspect-[16/10] bg-neutral-900 rounded-[2rem] overflow-hidden mb-8 border border-white/5 transition-all duration-700 group-hover:border-blue-500/30">
                        <div class="w-full h-full flex items-center justify-center text-gray-800 font-serif-sc italic text-xs group-hover:scale-110 transition-transform duration-1000">
                            [ 作品封面 ]
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-blue-900/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center">
                            <div class="p-5 bg-white/10 backdrop-blur-2xl rounded-full scale-75 group-hover:scale-100 transition-all border border-white/20">
                                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                            </div>
                        </div>
                        <div class="absolute top-6 left-6">
                            <span class="bg-black/40 backdrop-blur-xl text-white text-[8px] px-4 py-1.5 rounded-full border border-white/10 tracking-widest uppercase font-bold">
                                ${work.category}
                            </span>
                        </div>
                    </div>
                    <div class="space-y-3 px-2">
                        <h4 class="text-2xl font-bold group-hover:text-blue-400 transition-colors font-serif-sc">${work.title}</h4>
                        <p class="text-sm text-gray-500 font-light leading-relaxed">${work.desc}</p>
                    </div>
                `;
                grid.appendChild(item);
            });
        }

        function filterWorks(cat) {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                const btnText = btn.innerText;
                if(btnText === cat || (cat === '品牌/商业' && btnText === '商业')) {
                    btn.classList.add('bg-blue-600', 'text-white');
                    btn.classList.remove('text-gray-500');
                } else {
                    btn.classList.remove('bg-blue-600', 'text-white');
                    btn.classList.add('text-gray-500');
                }
            });
            renderWorks(cat);
        }

        window.onload = () => renderWorks();
    </script>
</body>
</html>
